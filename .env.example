# =============================================================================
# CONECTA HEAL ASSISTENCIAL - PRODUCAO
# =============================================================================
# IMPORTANTE: Nunca commite senhas reais em repositorio publico.
# Use .env.example como template e .env local para valores reais.
# =============================================================================

# Oracle Database Configuration
DB_HOST=192.168.1.21
DB_PORT=1521
DB_SERVICE=tasy
DB_USER=tasy
DB_PASSWORD=

# Server Configuration
PORT=3006
SESSION_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# CORS - Origins permitidas (separar por virgula, vazio = somente mesma origem)
ALLOWED_ORIGINS=

# Dashboard Cache
DASHBOARD_CACHE_ENABLED=true
DASHBOARD_CACHE_TTL_MS=30000
DASHBOARD_CACHE_STALE_MS=300000
DASHBOARD_CACHE_MAX_ENTRIES=50
DASHBOARD_CACHE_PREWARM_SETORES=68,28,34,59,83

# Database Required on Startup
DB_REQUIRED_ON_STARTUP=true

# LDAP/Active Directory
LDAP_ENABLED=true
LDAP_URL=ldap://192.168.1.4:389
LDAP_BASE_DN=DC=heal,DC=local
LDAP_USER_DOMAIN=heal
LDAP_ADMIN_USER=servico.ldap
LDAP_ADMIN_PASSWORD=

# Native SSO (o JWT Tasy e validado pelo backend confiavel)
NATIVE_SSO_ENABLED=true
TASY_TOKEN_VALIDATOR_URL=http://tasymanager.heal.br/api/medico/login
TASY_TOKEN_VALIDATOR_TIMEOUT_MS=8000
NATIVE_SSO_MAX_TOKEN_LENGTH=32768

# TasyNative Manager / politicas globais
TASY_NATIVE_MANAGER_URL=http://tasymanager.heal.br
POLICY_SERVICE_SECRET=

# Redis & Sessões
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
SESSION_TTL_HOURS=12

# Segurança e Proxy (ex: 'true', 'false', ou numero de hops '1')
TRUST_PROXY=1
COOKIE_SECURE=false

# Oracle Pool
DB_POOL_MIN=3
DB_POOL_MAX=15
DB_POOL_INCREMENT=2
DB_QUEUE_TIMEOUT=10
DB_IDLE_TIMEOUT=60
DB_CALL_TIMEOUT=15

# Observabilidade
METRICS_TOKEN=sua_senha_para_ver_metricas
